.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Build artifacts
*.egg-info/
dist/
build/
*.egg

# Testing / Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# Runtime data (auth, usage)
src/agentos/auth/users.json
src/agentos/auth/usage.json
src/agentos/auth/org_data.json
src/agentos/auth/usage.db
src/agentos/sandbox/sim_results.db

# Marketplace data
agent_data/

# OS
.DS_Store
Thumbs.db

# Sync-service conflict copies. iCloud Drive resolves a conflict by writing
# "cli 2.py" beside "cli.py"; those are stale duplicates of tracked files and
# must never be committed. They also get collected by pytest and counted by
# coverage, so see tests/conftest.py and [tool.coverage.run] for the other two
# halves of this guard. The real fix is to keep the repo out of a synced tree.
* [0-9].*
* [0-9]
* copy.*
* copy

# Logs
*.log

# Frontend
frontend/node_modules/
frontend/dist/

# AgentOS replay traces (ad hoc runs; scenario fixtures are committed).
# `agentos record` also writes a header index and future subdirectories under
# .agentos/, so ignore the whole trace root rather than the two known children.
.agentos/
!tests/fixtures/traces/
